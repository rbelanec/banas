# Managed by Ansible (roles/opengym) - edits here are overwritten on the next run.

# Passkey binding. Must match exactly how the browser reaches the site.
RP_ID={{ opengym_hostname }}
ORIGIN=https://{{ opengym_hostname }}
RP_NAME={{ opengym_rp_name }}

SESSION_DAYS={{ opengym_session_days }}

# Traefik terminates TLS and reaches the web container over the `proxy` network,
# so nothing is published to the host and WEB_PORT is unused.
NGINX_PORT=80
BACKEND=api
PORT=3000

# The web container overwrites X-Forwarded-For / X-Real-IP with its real peer and
# drops CF-Connecting-IP. Behind Traefik that peer is Traefik itself, so the API
# sees one address for every client (fine while PASSWORD_LOGIN and AUDIT_IP are
# off). Traefik is not Cloudflare, so leave CF_CONNECTING_IP empty - setting it
# would let a caller choose the address the audit log records.
CF_CONNECTING_IP=
{% if opengym_admin_uids | length > 0 %}

ADMIN_UIDS={{ opengym_admin_uids }}
{% endif %}
{% if opengym_invite_only | bool %}
INVITE_ONLY=1
{% endif %}
{% if not opengym_allow_guest | bool %}
ALLOW_GUEST=0
{% endif %}
