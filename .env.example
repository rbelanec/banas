# Copy to .env and fill in. .env is gitignored; this file is not, so keep it
# free of real values.

# 1Password Connect API token. Read by banas.yaml via
# lookup('ansible.builtin.env', 'OP_API_TOKEN') and passed to every
# onepassword.connect.item_info call. Issue one from the Connect server at
# https://op.belanec.eu (or `op connect token create`).
OP_API_TOKEN=
